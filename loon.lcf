# 🟢>>>>>>>>>>>本地脚本<<<<<<<<<<<<<<<🟢
[Script]
cron "0 0 * * *" then script("https://raw.githubusercontent.com/zqzess/rule_for_quantumultX/master/js/Mine/wnCalendar/wnCalendar.js") with tag="今日黄历", img_url="https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/friDay.png", timeout=10
cron "10 6 * * *" then script("https://raw.githubusercontent.com/deezertidal/private/main/tv.js") with tag="电视热度榜", img_url="https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/QQvideo.png", timeout=10
cron "12 7 * * *" then script("https://raw.githubusercontent.com/deezertidal/private/main/histoday.js") with tag="历史上的今天", img_url="https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/friDay.png", timeout=10
generic then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/tools/NodeUnlockDetection.js") with tag="节点解锁查询", img_url="https://raw.githubusercontent.com/tugepaopao/Image-Storage/master/cartoon/Cute/3icon.png", timeout=20
generic then script("https://raw.githubusercontent.com/getsomecat/Loon/main/Net_Speedlite.js") with tag="网络延迟测试", img_url="https://raw.githubusercontent.com/tugepaopao/Image-Storage/master/cartoon/Cute1/1643998.png", timeout=10
generic then script("https://github.com/Keywos/rule/raw/main/loon/ipapi2.js") with tag="测试位置查询", img_url="https://raw.githubusercontent.com/tugepaopao/Image-Storage/master/cartoon/Cute1/2921096.png", timeout=10
generic then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/tools/LocationDetection.js") with tag="地理位置查询", img_url="https://raw.githubusercontent.com/tugepaopao/Image-Storage/master/cartoon/Cute/in.png", timeout=10
generic then script("https://raw.githubusercontent.com/MCdasheng/Loon/main/Streaming/Spotify.js") with tag="SpotifyCheck", img_url="https://raw.githubusercontent.com/tugepaopao/Image-Storage/master/cartoon/Cute/spotify.png", timeout=10
generic then script("https://raw.githubusercontent.com/Loon0x00/LoonExampleConfig/master/Script/generic_example.js") with tag="GeoLocation", img_url="https://raw.githubusercontent.com/tugepaopao/Image-Storage/master/cartoon/Cute1/1249982.png", timeout=10
generic then script("https://raw.githubusercontent.com/MCdasheng/Loon/main/Streaming/ChatGPT.js") with tag="GPTCheck", img_url="https://raw.githubusercontent.com/tugepaopao/Image-Storage/master/cartoon/Cute1/1818292.png", timeout=10
